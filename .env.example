# PortVPNtoQbit — Configurações
# Copie este arquivo para .env e preencha com suas credenciais.
# O arquivo .env NÃO deve ser commitado em repositórios públicos.

# Credenciais do qBittorrent (Web UI)
QB_HOST=http://127.0.0.1:8080
QB_USERNAME=admin
QB_PASSWORD=SUA_SENHA_AQUI

# (Opcional) Caminho customizado para o log da ProtonVPN.
# Se não definido, o caminho padrão é detectado automaticamente via %LOCALAPPDATA%.
# PROTON_LOG_PATH=C:/Users/SeuUsuario/AppData/Local/Proton/Proton VPN/Logs/client-logs.txt

# (Opcional) Ajustes de comportamento
# DEBOUNCE_SECONDS=1.0        # Tempo de espera após modificação do log antes de agir
# LOGIN_RETRY_ATTEMPTS=5      # Tentativas de login se o qBittorrent não estiver rodando
# LOGIN_RETRY_DELAY=3.0       # Segundos entre tentativas de login
